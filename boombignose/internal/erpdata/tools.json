  {
    "name": "list_invoices",
    "description": "Read invoices plus receivables_coverage: complete workspace issued-unpaid count/total and bounded records (has_more). For an overall unpaid/collection overview, call once without status/client filters; reuse that coverage instead of separate status reads or finance_summary. Use additional filters only for requested details missing from the bounded result. paid_satang is verified receipts; credited_satang is credits, not cash.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "sent",
            "partially_paid",
            "paid",
            "overdue",
            "cancelled"
          ],
          "description": "Optional invoice status filter. partially_paid includes settlement by credits; cash receipts are reported separately in paid_satang."
        },
        "client_id": {
          "type": "string",
          "description": "Optional client UUID filter."
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "description": "Maximum number of items to return (1..100, default 50)."
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "description": "Zero-based item offset for pagination (default 0).",
          "maximum": 1000000
        }
      },
      "additionalProperties": false
    }
  },
